{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "smashburgers.chiqo.cc.cd"
        }
      ],
      "destination": "/smash-burgers/en/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "smashburgers.chiqo.cc.cd"
        }
      ],
      "destination": "/smash-burgers/en/:path*"
    }
  ]
}
